{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apprewqi",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "37a68b5e-34a9-4038-80f7-48b3ca8d00ba","database_name": "web-appbvcgf" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "707e2aefaabd44bc802fc670c049aff8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
